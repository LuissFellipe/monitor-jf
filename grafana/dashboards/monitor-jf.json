    {
      "id": 9,
      "type": "barchart",
      "title": "Ruas sem luz por dia",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
