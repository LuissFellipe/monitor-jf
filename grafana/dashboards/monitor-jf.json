    {
      "id": 12,
      "type": "bargauge",
      "title": "Bairros com mais interrupções registradas",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitor-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitor-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select bairro,\n                 count(distinct data) filter (where servico = 'luz')\n                 + count(distinct local) filter (where servico = 'agua' and bairro <> 'Nao Identificado') as ocorrencias\n          from marts.fct_interrupcoes where $__timeFilter(data)\n          group by bairro order by ocorrencias desc limit 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        }
      }
    },
