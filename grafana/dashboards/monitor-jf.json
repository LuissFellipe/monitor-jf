            "uid": "monitor-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select local, servico, to_char(data, 'DD/MM') || ' (' || (array['dom','seg','ter','qua','qui','sex','sáb'])[extract(dow from data)::int + 1] || ')' as dia, horario, bairro, detalhe, situacao\n          from marts.fct_meus_locais where data >= current_date order by data, local"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Nenhuma interrupção programada nos seus locais",
