      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitor-pg"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "select to_char(data, 'DD/MM') || ' (' || (array['dom','seg','ter','qua','qui','sex','sáb'])[extract(dow from data)::int + 1] || ')' as dia, count(*) as ruas\n          from marts.fct_interrupcoes where servico = 'luz' and data >= current_date\n          group by data order by data"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
